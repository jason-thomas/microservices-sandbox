{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "EventGrid": {
    "NamespaceEndpoint": "https://<your-namespace>.eventgrid.azure.net",
    "Credential": {
      "Key": "<replace-with-access-key>"
    },
    "MaxEventsPerReceive": 10,
    "MaxWaitTimeSeconds": 60,
    "Subscriptions": [
      {
        "Name": "default",
        "TopicName": "orders",
        "SubscriptionName": "orders-subscription",
        "EventTypes": [
          "UserRegistered",
          "OrderCancelled"
        ],
        "MaxEventsPerReceive": 10,
        "MaxWaitTimeSeconds": 60
      }
    ]
  }
}
